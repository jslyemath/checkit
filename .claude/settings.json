{
  "env": {
    "CHECKIT_PRINTIT_MASK_NAMES": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_heredoc.py\"",
            "statusMessage": "Checking for heredocs and skipped git hooks"
          }
        ]
      }
    ]
  }
}
